<Project>
	<PropertyGroup>
		<!-- TargetFramework is available here (after the project file), unlike Directory.Build.props -->
		<MicrosoftPackageVersion Condition="'$(TargetFramework)' == 'net6.0'">6.0.*</MicrosoftPackageVersion>
		<MicrosoftPackageVersion Condition="'$(TargetFramework)' == 'net7.0'">7.0.*</MicrosoftPackageVersion>
		<MicrosoftPackageVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.*</MicrosoftPackageVersion>
		<MicrosoftPackageVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.*</MicrosoftPackageVersion>
	</PropertyGroup>
</Project>
