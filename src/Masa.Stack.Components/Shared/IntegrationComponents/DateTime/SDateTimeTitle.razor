@namespace Masa.Stack.Components
@inherits MasaComponentBase

@if(DateTime)
{
    <div class="@(Class??"body text--secondary")">@Value?.ToString(T("$DateTimeFormat"))</div>
}
@if(Date)
{
   <div class="body text--secondary">@Value?.ToString(T("$DateFormat"))</div>
}
@if(Time)
{
    <div class="body2 text--disabled">@Value?.ToString("HH:mm:ss")</div>
}

