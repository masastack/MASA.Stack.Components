@namespace Masa.Stack.Components
@inherits MasaComponentBase

<MTooltip Top>
    <ActivatorContent>
        <MChip Small Label Color="secondary" Class="@Class" @attributes="@context.Attrs">
            @(Offset.Hours > 0 ? $"+{Offset.Hours}" : Offset.Hours.ToString())
        </MChip>
    </ActivatorContent>
    <ChildContent>
        <span>@(T(scope: DateTimeRangeScope, "Current Selected TimeZone"))</span>
    </ChildContent>
</MTooltip>

@code {

    [Parameter]
    public TimeSpan Offset { get; set; }
}
